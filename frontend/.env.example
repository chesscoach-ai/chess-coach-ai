AUTH_SECRET=generate-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DATABASE_URL=
BACKEND_URL=http://127.0.0.1:8000
# Facultatif en local, obligatoire en production et identique côté API Python.
BACKEND_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_WEBHOOK_SECRET=
# Les paiements restent impossibles tant que cette bascule vaut false.
COMMERCIAL_LAUNCH_ENABLED=false
ANALYSIS_PRICE_MONTHLY_CENTS=299
ANALYSIS_PRICE_ANNUAL_CENTS=2499
# Adresses autorisées à tester l’analyse sur une préversion Render.
ANALYSIS_PREVIEW_EMAILS=
# Empreintes SHA-256 d'adresses autorisées à vie, séparées par des virgules.
ANALYSIS_LIFETIME_EMAIL_HASHES=
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_PUBLICATION_DIRECTOR=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
# Passer à true uniquement après validation humaine/juridique des documents.
LEGAL_DOCUMENTS_REVIEWED=false
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
# Web Push : générez la paire avec `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:votre-email@example.com
# Secret long utilisé par le planificateur qui appelle /api/push/dispatch.
CRON_SECRET=
# Déverrouillage local uniquement. Ne jamais activer en production.
ANALYSIS_DEV_UNLOCK=false

# URL HTTPS chargée par les applications Capacitor pendant la phase hybride.
# Exemple : https://chess-coach-web-x6vz.onrender.com
# Ne jamais utiliser localhost pour une version distribuée aux testeurs.
CAPACITOR_SERVER_URL=

# À remplir seulement après la création des comptes développeur mobiles.
# Les clés privées ne doivent jamais être préfixées par NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
