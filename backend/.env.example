# Accès interne depuis le frontend Next.js. Obligatoire en bêta, vide en local.
BACKEND_API_SECRET=
# PostgreSQL est obligatoire en bêta. Sans valeur, le local utilise SQLite pour les caches.
DATABASE_URL=
PORT=8000

# Configuration gratuite validée pour la bêta privée.
STOCKFISH_PATH=
STOCKFISH_POOL_SIZE=1
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=32
STOCKFISH_MAX_QUEUE_SIZE=6
STOCKFISH_DEFAULT_DEPTH=15
STOCKFISH_QUEUE_TIMEOUT=3
STOCKFISH_ANALYSIS_TIMEOUT=10
STOCKFISH_TOTAL_TIMEOUT=12
STOCKFISH_MAX_RETRIES=1
STOCKFISH_PROTOCOL_TIMEOUT_GRACE=0.25
STOCKFISH_SLOW_OPERATION_THRESHOLD=5
STOCKFISH_BASELINE_MULTIPV=3

# Cache. Les fichiers SQLite restent locaux et ne doivent pas être commités.
ANALYSIS_CACHE_L1_MAX_ENTRIES=256
ANALYSIS_CACHE_SQLITE_PATH=
CACHE_NAMESPACE_VERSION=1
STOCKFISH_CACHE_ENGINE_VERSION=17
STOCKFISH_ANALYSIS_PROFILE_VERSION=standard-v1
NOX_CACHE_SQLITE_PATH=
NOX_PROMPT_VERSION=v1

# OpenAI reste volontairement désactivé pendant la bêta 2.8.
OPENAI_API_KEY=
NOX_OPENAI_MODEL=
RUN_NOX_LIVE_TESTS=false
NOX_BENCHMARK_APPROVED=false
